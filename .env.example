# 本文件是模板，进 git。复制一份改名 .env 后填真实值：Copy-Item .env.example .env
# .env 保存真实密码，已被 .gitignore 挡住，不要提交。
# 字段名必须和 app/core/config.py 里的字段一一对应（大小写不敏感）。

# ---- 数据库 ----
# 数据库跑在 Docker 里（见 docker-compose.yml），映射到本机 3307。
# 端口是 3307 而不是 3306：你本机已经装了 MySQL 并占用 3306，用 3307 避免冲突。
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=root
DB_NAME=fengxuan_agent
# 必填，没有默认值：留空或删掉这一行，服务启动就会报校验错误（这是故意的）。
# 这个值同时是 MySQL 容器的 root 密码，首次启动容器时生效，改它不会改已有数据卷里的密码。
DB_PASSWORD=

# ---- 运行环境：dev / prod ----
APP_ENV=dev

# ---- 认证 ----
# 必填，没有默认值。生成方式（在项目根目录执行）：
# uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=
# 登录 token 有效期，单位分钟。阶段一定为 30，见 docs/progress.md
JWT_EXPIRE_MINUTES=30

# ---- 跨域：前端地址，多个用英文逗号分隔 ----
# 不要写 * ：允许所有来源等于没有跨域保护
CORS_ORIGINS=http://127.0.0.1:5176,http://localhost:5176

# ---- Redis（阶段三才用到，先留空占位，等那时再加到 config.py）----
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6380
# REDIS_DB=0
