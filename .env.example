# 本文件是模板，可以提交 git。首次使用时复制为 .env，再填写真实值。
# 已有 .env 时只手动补充缺少的字段，保留原有数据库密码和 JWT 密钥。
# .env 保存真实密码，已被 .gitignore 挡住，不要提交。
# 字段名必须和 app/core/config.py 里的字段一一对应（大小写不敏感）。

# ---- 数据库 ----
# 数据库跑在 Docker 里（见 docker-compose.yml），映射到本机 3307。
# 端口是 3307 而不是 3306：你本机已经装了 MySQL 并占用 3306，用 3307 避免冲突。
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=root
DB_NAME=fengxuan_agent
# 必填，没有默认值：留空或删掉这一行，服务启动就会报校验错误（这是故意的）。
# 这个值同时是 MySQL 容器的 root 密码，首次启动容器时生效，改它不会改已有数据卷里的密码。
DB_PASSWORD=

# ---- 运行环境：dev / prod ----
APP_ENV=dev

# ---- 认证 ----
# 必填，没有默认值。生成方式（在项目根目录执行）：
# uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=
# 登录 token 有效期，单位分钟。阶段一定为 30，见 docs/progress.md
JWT_EXPIRE_MINUTES=30
# 必填（改密、新建用户前）。新版密码哈希用的服务器密钥，至少 32 字节的随机值。
# 生成方式见 docs/commands.md 第二节；必须备份：丢失后所有改过密的账号都无法再登录。
# 不要提交到 git，也不要把真实值写进本模板。
PASSWORD_PEPPER=

# ---- 跨域：前端地址，多个用英文逗号分隔 ----
# 不要写 * ：允许所有来源等于没有跨域保护
CORS_ORIGINS=http://127.0.0.1:5176,http://localhost:5176,http://127.0.0.1:5178,http://localhost:5178

# ---- 第三方模型：OpenAI 兼容的 Chat Completions 接口 ----
# 基础地址不带 /chat/completions，客户端会自动追加请求路径。
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
# 使用对话前填写平台生成的 API Key。模板留空，不要提交真实密钥。
LLM_API_KEY=
# 整个生成过程的总时限，单位秒，包含连接、重试和等待片段。
LLM_TIMEOUT_SECONDS=60
# 只在尚未输出内容的建连阶段重试，范围 0-3；默认不自动重试。
LLM_MAX_RETRIES=0
# 每次回答的输出 token 上限，不是整个模型的上下文容量。
LLM_MAX_OUTPUT_TOKENS=2048

# ---- Redis：只缓存可从 MySQL 重建的近期上下文 ----
# false 表示停用缓存；连接失败也会自动回源 MySQL。
REDIS_ENABLED=true
REDIS_HOST=127.0.0.1
# 本机 Docker 映射端口为 6380，容器内部默认端口为 6379。
REDIS_PORT=6380
# 字段名为 REDIS_DATABASE，不是旧占位中的 REDIS_DB。
REDIS_DATABASE=0
# 本地容器默认未配置密码；服务器按实际情况填写，模板留空。
REDIS_PASSWORD=
# 缓存连接和读写超时，单位秒，避免缓存故障拖慢对话。
REDIS_TIMEOUT_SECONDS=0.3

# ---- 对话上下文与缓存限制 ----
# Redis 副本有效期，单位秒；到期后从 MySQL 重新查询。
CHAT_CACHE_TTL_SECONDS=1800
# 只保留最近的完整成功轮次，范围 1-50。
CHAT_CONTEXT_ROUNDS=10
# 历史总字符上限，范围 4000-100000，不是精确 token 计数。
CHAT_CONTEXT_MAX_CHARACTERS=12000
# 单次回答的字符保护上限，范围 1-1000000。
CHAT_MAX_ANSWER_CHARACTERS=50000
# 生成中有新增文字时定期保存到 MySQL，单位秒，范围 0.1-30；无新增不写库。
CHAT_PARTIAL_SAVE_INTERVAL_SECONDS=2

# ---- 过期生成自动恢复 ----
# 启动后立即扫描，随后定期扫描；只恢复已过期占用，不中断有效请求。
CHAT_RECOVERY_ENABLED=true
# 每批扫描结束后等待的秒数，范围 0.1-3600。
CHAT_RECOVERY_INTERVAL_SECONDS=30
# 每轮最多恢复的会话数，范围 1-500；积压由后续轮次继续处理。
CHAT_RECOVERY_BATCH_SIZE=100

# 全站有效生成占用上限；同一用户可跨会话并行，每个会话仍限一个。
CHAT_GLOBAL_CONCURRENCY_LIMIT=10

# ---- 完整请求预算：UTF-8 字节加结构余量的保守估算，并非精确 token 数 ----
# 应用采用的兼容预算窗口，应不高于实际供应商模型容量；不是自动探测值。
LLM_CONTEXT_WINDOW_TOKENS=32768
# 系统提示词、历史、当前问题及消息开销的总输入预算。
CHAT_INPUT_TOKEN_BUDGET=24000
# 在窗口内额外预留的安全空间；另会预留 LLM_MAX_OUTPUT_TOKENS。
CHAT_CONTEXT_SAFETY_TOKENS=512

# ---- 可选后台缓存预热：不阻塞 completed 和流结束 ----
# Redis 停用时同样不创建队列；跳过预热不影响 MySQL 历史及按需回源。
CHAT_PREWARM_ENABLED=true
# 每个后端进程的排队容量和工作任务数；满额跳过，不等待空位。
CHAT_PREWARM_QUEUE_CAPACITY=20
CHAT_PREWARM_WORKERS=2
# 关闭时丢弃排队任务，最多等待执行中任务的秒数；同步 I/O 无法强制终止。
CHAT_PREWARM_SHUTDOWN_SECONDS=1
