# 环境目录：本地产物，可以从 uv.lock 随时重建，绝不提交
.venv/

# 真实配置与密钥：服务器上单独放，绝不提交
.env

# Python 运行产物
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/

# 编辑器
.vscode/
.idea/

# 系统
Thumbs.db
.DS_Store

# 命令输出日志：uv 等命令重定向到文件的产物，跑完即删，不进版本库
*_log.txt

# pytest 临时目录（addopts 里 --basetemp 指向这里）
.pytest-tmp/

# 向量模型缓存：可从镜像重新下载
.cache/
